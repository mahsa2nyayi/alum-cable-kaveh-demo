# Copy to `.env` (never commit the real file) and fill in the values.

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://alum:CHANGE_ME@localhost:5432/alum_cable?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production, >= 32 chars. Generate:  openssl rand -base64 48
JWT_SECRET=""

# ── Public site URL (used for metadata, sitemap and CSRF origin check) ───────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Contact-form e-mail notification (optional) ──────────────────────────────
# Leave CONTACT_RECIPIENT empty and no e-mail is sent: messages are still
# stored in the database and shown in /admin/dashboard.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
CONTACT_RECIPIENT=""

# ── Local testing only ───────────────────────────────────────────────────────
# Allow the admin cookie over plain http when running `npm run build && npm start`
# on localhost. NEVER set this on a real server.
# ALLOW_INSECURE_COOKIES="true"

# ── Seeding (only read by `npm run db:seed`) ─────────────────────────────────
# SEED_DEMO_DATA="true"            # adds sample contact messages
# DEMO_ADMIN_EMAIL="admin@example.com"
# DEMO_ADMIN_PASSWORD=""           # >= 12 characters

# ── Docker Compose only ───────────────────────────────────────────────────────
# Password of the bundled PostgreSQL container (also used to build DATABASE_URL).
POSTGRES_PASSWORD=""
